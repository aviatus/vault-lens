{
  "name": "vault-lens",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:e2e": "playwright test",
    "package": "npm test && node scripts/package.js",
    "version": "node scripts/sync-version.js",
    "vault:up": "docker compose -f e2e/docker-compose.yml up -d && node e2e/seed.js",
    "vault:down": "docker compose -f e2e/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.24.2"
  }
}
